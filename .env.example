# Copy this file to .env and fill it in. .env is never committed.
PORT=4100

# Your PostgreSQL connection. The database (agent_studio) is created for you by "npm run db:setup".
# If the password has characters like @ # : / write them URL-encoded, or use set-password.cmd on Windows.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/agent_studio

# The project folder the control room opens first. Any folder can be chosen in the app.
# DEFAULT_WORKDIR=C:\path\to\your\project

# Optional. Without it, the agents use the Claude Code login on this computer.
# ANTHROPIC_API_KEY=

# Optional. Raises GitHub's rate limit when installing skills from GitHub.
# GITHUB_TOKEN=
